# Production uses a secret manager; .env is for local use only.
APP_ENV=development
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct URL is for local/CI migrations only; do not expose to the frontend.
DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.region.aws.neon.tech/neondb?sslmode=require
DATABASE_SCHEMA=public
CRON_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
# Generate using Fernet.generate_key(); securely back it up before accepting codes.
DATA_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:8081
PUBLIC_APP_URL=http://localhost:8081
# Private S3 storage. Prefer an instance role; block all bucket public access.
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
# STARTTLS on 587; SMTP_SSL=true for implicit TLS on 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Optional existing managed integrations; blank disables them.
GOOGLE_AUTH_SESSION_URL=
OBJECT_STORAGE_BASE_URL=
OBJECT_STORAGE_INTEGRATION_KEY=
# Local development only; ignored in production.
EXPOSE_DEV_RESET_TOKEN=false
# Enter payout keys through authenticated Admin / Payout Providers.
