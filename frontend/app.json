{
  "expo": {
    "name": "Bring Gift Card",
    "slug": "bring-gift-card",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bringgiftcard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bringgiftcard.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F3F8FF"
      },
      "package": "com.bringgiftcard.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-blue.png",
          "imageWidth": 210,
          "resizeMode": "contain",
          "backgroundColor": "#F3F8FF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
