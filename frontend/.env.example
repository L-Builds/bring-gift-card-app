# Public BUILD-TIME configuration. Copy to .env for local development only.
# Vercel: set these in Project Settings > Environment Variables and redeploy.
# Use the staging backend HTTPS origin, WITHOUT /api or a trailing path.
# Never put secrets in EXPO_PUBLIC_* variables: they are included in browser JS.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional managed Google auth entry URL. Leave blank to disable Google sign-in.
EXPO_PUBLIC_GOOGLE_AUTH_URL=
